# ========================================
# OPTION 1: Deny routes folder, ALLOW images
# ========================================
# RewriteEngine On
# 
# # Deny access to routes folder
# RewriteCond %{REQUEST_URI} ^/routes/ [NC]
# RewriteRule ^ - [F,L]

# ========================================
# OPTION 2: Deny routes folder AND specific images
# ========================================
RewriteEngine On

# Deny access to routes folder
RewriteCond %{REQUEST_URI} ^/routes/ [NC]
RewriteRule ^ - [F,L]

# Deny access to specific image (logo.png)
RewriteCond %{REQUEST_URI} ^/images/logo\.png$ [NC]
RewriteRule ^ - [F,L]

# ========================================
# OPTION 3: Deny routes folder AND all images
# ========================================
# RewriteEngine On
# 
# # Deny access to routes folder
# RewriteCond %{REQUEST_URI} ^/routes/ [NC]
# RewriteRule ^ - [F,L]
# 
# # Deny access to entire images folder
# RewriteCond %{REQUEST_URI} ^/images/ [NC]
# RewriteRule ^ - [F,L]

# ========================================
# Alternative: Using Directory directives
# ========================================

# Deny routes folder
<DirectoryMatch "^.*/routes(/|$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</DirectoryMatch>

# Deny specific file (logo.png)
<FilesMatch "^logo\.png$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Protect other sensitive files
<FilesMatch "\.(env|htaccess|htpasswd|ini|log|sh|sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>